# `openssl rand -hex 32` bilan yarating; bu qiymatni GitHubga yozmang.
JWT_MAXFIY_KALIT=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talim
BAZA_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Yangi modulli endpointlar uchun leak-safe PostgreSQL ulanish havzasi.
# Railway/PostgreSQL connection limitiga qarab sozlang. Har backend
# processi shu miqdorgacha ulanish ochadi; PgBouncer ishlatilsa ham
# qiymatni nazoratli saqlang.
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_POOL_WAIT_SECONDS=8
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000

# Google orqali kirish ishlatilsa:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram integratsiyasi ishlatilsa:
BOT_TOKEN=

# Faqat AI Ustoz, yozma javob tekshiruvi va 45 daqiqalik dars uchun:
GROQ_API_KEY=
