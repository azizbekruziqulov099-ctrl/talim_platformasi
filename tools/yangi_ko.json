  "s0c05e3b2dc": "🧍 상자 앞에",
  "s0d50035cb0": "🍵 찻잔",
  "s0e0144b52f": "🏃🏃 그들은 달리고 있어요.",
  "s0fa3345b58": "👵 할머니 댁에 갔어요.",
  "s108f577d6d": "🐭 생쥐",
  "s10cfa91a90": "🐕 큰 개를 봤어요.",
  "s1260ac1683": "🍽️ 접시",
  "s13310e1540": "🌈 무지개요.",
  "s163dc433a3": "🎤 그녀는 노래하고 있어요.",
  "s201c350ef7": "🫓 빵집 앞에",
  "s21909ea8cf": "🧸 놀고 있어요.",
  "s252c9680b7": "🆘 도와줘!",
  "s25460658a2": "🏃 달려요",
  "s261b7b91c9": "🐟 물고기가 헤엄치고 있어요.",
  "s2674b8edd0": "🍽️ 저녁밥",
  "s2b92008669": "🕢 일곱 시 반이에요.",
  "s2c06e7d2e4": "👌 괜찮아.",
  "s2c73fba6b5": "🦒 그는 동물원에 갔어요.",
  "s301f427fab": "🦁🐭 사자와 생쥐",
  "s30f599aa89": "😊 기뻐요",
  "s338833499b": "🗺️ 저기요! 동물원이 어디예요?",
  "s345a4270a5": "🐕 개",
  "s366c4eedda": "📅 어제 뭐 했어?",
  "s38c6f08adb": "🍎 사과요!",
  "s3b63db7edf": "👋 안녕하세요! 제 이름은 알리예요.",
  "s3ea889d80f": "🌅 좋은 아침이에요, 엄마!",
  "s41ea891720": "💧 물을 마셔요!",
  "s439c701ab4": "🙇 미안해!",
  "s468de2abbc": "🛁 목욕",
  "s46fb1338dd": "💃 춤춰요",
  "s4c8c98009b": "🏫 학교에 가요.",
  "s4f775fd56f": "🛏️ 침대",
  "s5108fddee5": "😄 재미있었어요!",
  "s522a8c9a6e": "❓ 뭐 하고 있어?",
  "s58c8b13001": "🎒 네! 학교 갈 준비 됐어요!",
  "s5b5b7be967": "🕗 여덟 시예요.",
  "s60ea2c8919": "🥄 섞어요",
  "s61a6af23d6": "🥱 그녀는 게을러요.",
  "s62914f7925": "😴 잘 자요!",
  "s633547edf0": "🎒 가방",
  "s63686e0d9c": "🧼 세수해요.",
  "s63b20aac1f": "🥬 커다란 순무",
  "s64ccc16fde": "😴 자요",
  "s65ac6a5bee": "📖 책을 읽고 있어요.",
  "s6a27f46bf3": "🐈😴 고양이가 자고 있어요.",
  "s6dc1c04b51": "❓ 공원이 어디예요?",
  "s6f05b16795": "🎉 만세!",
  "s7022ef1148": "🥄 숟가락",
  "s73c66cd399": "🌲 숲",
  "s789f191d7b": "🐱 상자 옆에",
  "s7a26f4bd68": "👋 안녕, 또 만나!",
  "s7c5388e2d5": "🍲 점심을 먹어요.",
  "s7d47138785": "🍦 아이스크림을 먹었어요.",
  "s7e5612d48a": "🔪 잘라요",
  "s7e7b531675": "⬅️ 왼쪽으로 돌아요!",
  "s801036b3f9": "📚 도서관",
  "s81eabb16c6": "📺 텔레비전을 봐요.",
  "s858865d2c3": "🦒 우리는 동물원에 갔어요.",
  "s867d159911": "🛏️ 일어나요.",
  "s86999eb744": "⚽ 축구를 했어요.",
  "s8dbae03250": "🤝 내 친구가 되어 줘!",
  "s903af7eea4": "❓ 몇 시예요?",
  "s90406d718e": "🤕 머리가 아파요.",
  "s90fcfaa190": "🐕💨 강아지가 달리고 있어요.",
  "s91a93f9346": "🚸 횡단보도",
  "s92ed9acc2a": "🚏 버스 정류장",
  "s96213832c7": "📦 주므라드와 키마트",
  "s9e92dc9e3e": "📚 도서관 뒤에",
  "s9f2e489c42": "👩‍⚕️ 간호사",
  "s9fbbfa91bc": "🐕 큰 개요.",
  "s9fef2c7a82": "👵 그는 할머니 댁에 갔어요.",
  "sa141a0cf73": "🍴 포크",
  "sa17c9c82c2": "🌈 무지개를 봤어요.",
  "sa180ba08d0": "⌚ 손목시계가 있어요.",
  "sa2901853b4": "🫓 빵집",
  "sa4ea31ddcd": "🙅 아니요, 괜찮아요.",
  "saa389104cb": "😄 기뻐요.",
  "saa5eb5401a": "🦁 동물원",
  "sabd4e4076e": "🍳 아침밥",
  "sabf9a7ab19": "✋ 기다려요!",
  "sae94541109": "🌳 공원",
  "safb092e609": "😢 슬퍼요.",
  "sb03a2c4059": "🎒 학교 갈 준비 됐어요!",
  "sb04a873aec": "✏️ 숙제를 해요.",
  "sb09f5fd3d0": "🚶 가자!",
  "sb2fdd73dc2": "🐦🎶 새들이 노래하고 있어요.",
  "sb33b879507": "❓ 무슨 일이야?",
  "sb6e1529f15": "🍳 아침을 먹어요.",
  "sb815290ce2": "🥣 그릇",
  "sb8b3974804": "😴 그는 자고 있어요.",
  "sb99e0dfa7f": "⏰ 일어나요.",
  "sbae380f749": "😠 화나요",
  "sbd3037ccc7": "🌳 공원 옆에",
  "sbeeaa72001": "😔 미안해!",
  "sc53f439538": "⬆️ 앞으로 쭉 가요!",
  "sc59548e1dc": "🌳 공원에 갔어요.",
  "sc61cc8dfaf": "🦁🙏🐭 고마워, 꼬마 생쥐야!",
  "sc6fb8bb190": "⚽ 그는 축구를 했어요.",
  "sc71410b1d9": "😴 그녀는 자고 있어요.",
  "scaa1da28d8": "🧼 손을 씻어요!",
  "scd2bbf54b4": "🛏️ 자러 가요.",
  "scdded1de23": "🫖 차 드실래요?",
  "sd37aeafabd": "🫴 여기 있어요.",
  "sd72c2fef29": "👉 네 차례야!",
  "sd7c8d5fc9c": "🥛 마셔요",
  "sdcba4d6e43": "💧 마셔요",
  "sdd42f80188": "🤢 배가 아파요.",
  "sdd8f9d057b": "🍽️ 먹고 있어요.",
  "sde521c8973": "👏 박수 쳐요",
  "sdeda180b1b": "🤲 부탁해요!",
  "se252dacc43": "🚦 신호등",
  "se5c8b2e8af": "⌚ 손목시계",
  "se5eb2560fa": "🍞 먹어요",
  "se977f3c44a": "🐈 고양이",
  "seb3ee280e7": "👍 네, 주세요.",
  "sed04d64ad3": "🚗 자동차를 가지고 놀고 있어요.",
  "sf04689f310": "🦘 뛰어요",
  "sf2d013f897": "😊 그녀는 착해요.",
  "sf398fa49ac": "🍎 과일을 먹어요!",
  "sf6711144b2": "➡️ 오른쪽으로 돌아요!",
  "sf67d975963": "👋 다녀올게요, 엄마!",
  "sf817c56789": "🙏 아니요, 괜찮아요.",
  "sfbd25ed7b3": "📖 그녀는 책을 읽고 있어요.",
  "sfc0aff807d": "👀 왼쪽 오른쪽을 봐요!",
  "sfd4c636b9d": "👕 옷을 입어요.",
  "sff02d84f56": "🦒 큰 기린이요.",
  "s00a9e6c0ad": "🤔 기분이 어때?\n😄 기뻐요.\n😢 슬퍼요.\n😠 화나요",
  "s04cdd59831": "🚦 신호등\n🔴 기다려요!\n👀 왼쪽 오른쪽을 봐요!\n🚏 버스 정류장",
  "s132d3ab08b": "🦁 사자\n🕸️ 그물\n🆘 도와줘!\n🐭 고마워, 꼬마 생쥐야!",
  "s159d0f2e38": "🥬 순무\n💪 당겨, 당겨, 당겨!\n🐭 생쥐\n🎉 만세!",
  "s1754b0e0e9": "🐈😴 고양이가 자고 있어요.\n🐕💨 강아지가 달리고 있어요.\n🐦🎶 새들이 노래하고 있어요.\n🐟 물고기가 헤엄치고 있어요.",
  "s175c27809b": "🫖 차 드실래요?\n👍 네, 주세요.\n🙏 아니요, 괜찮아요.\n😋 맛있어요!",
  "s17a64c05c7": "🎒 가방\n🚶 가자!\n🏫 유치원에 가요.",
  "s17ed78b8da": "🍎 과일을 먹어요!\n💧 물을 마셔요!\n😴 잘 자요!\n🧼 손을 씻어요!",
  "s2136b84f63": "😴 그는 자고 있어요.\n🎤 그녀는 노래하고 있어요.\n🏃🏃 그들은 달리고 있어요.",
  "s238e40a4f3": "🍞 빵 주세요!\n🙏 고마워요!\n😊 천만에요.",
  "s25f6462109": "❓ 매일 뭐 해요?\n🏫 학교에 가요.\n🍲 점심을 먹어요.\n👫 친구들이랑 놀아요.",
  "s3ab4ec57b5": "👏 짝, 짝, 짝!\n🦘 뛰어요, 뛰어요, 뛰어요!\n💃 춤춰요, 춤춰요, 춤춰요!",
  "s3d22f68c54": "🍽️ 저녁밥\n🛁 목욕\n🛏️ 자러 가요\n🌙 잘 자요!",
  "s3e2042c6a8": "⏰ 일어나요!\n🌅 좋은 아침이에요!\n🍳 아침밥",
  "s437b49b1da": "🍰 케이크 주세요!\n🙏 고마워요!\n🙇 미안해!",
  "s5eef593f15": "⏰ 일어나요.\n🧼 세수해요.\n🍳 아침을 먹어요.\n👕 옷을 입어요.",
  "s6662ca0362": "❓ 뭐 하고 있어?\n🧸 놀고 있어요.\n📖 책을 읽고 있어요.\n🍽️ 먹고 있어요.",
  "s724d0a3e0c": "🥗 샐러드를 만들자!\n🔪 잘라요\n🥄 섞어요\n🥣 그릇",
  "s747b02e8a3": "❓ 몇 시예요?\n🕖 일곱 시예요.\n🕢 일곱 시 반이에요.\n⌚ 손목시계",
  "s7a47d1c4d8": "📅 어제 뭐 했어?\n⚽ 축구를 했어요.\n🌳 공원에 갔어요.",
  "s86608070fe": "❓ 무슨 일이야?\n🤒 아파요.\n🤕 머리가 아파요.\n🤢 배가 아파요.",
  "s8bdb5725ab": "❓ 동물원이 어디예요?\n⬆️ 앞으로 쭉 가요!\n⬅️ 왼쪽으로 돌아요!\n➡️ 오른쪽으로 돌아요!",
  "s96becfd1a6": "🌳 공원\n📚 도서관\n🦁 동물원\n🫓 빵집",
  "s9e11d7d2c1": "🗺️ 고양이 어디 있어?\n🐱📦 상자 옆에\n🫣📦 상자 뒤에\n🧍📦 상자 앞에",
  "sa459c47ae8": "👋 안녕하세요! 제 이름은 …예요.\n🎂 여섯 살이에요.\n🏠 …에 살아요.\n❤️ …을 좋아해요.\n🎒 학교 갈 준비 됐어요!",
  "sad8cb13672": "🧼 씻어요, 씻어요, 손을 씻어요!\n🪥 닦아요, 닦아요, 이를 닦아요!",
  "sb5ad0283d8": "🍞 빵 — 먹어요\n🥛 우유 — 마셔요\n💧 물 — 마셔요",
  "sb82fd70987": "✏️ 숙제를 해요.\n🍽️ 저녁을 먹어요.\n📺 텔레비전을 봐요.\n🛏️ 자러 가요.",
  "sb986a4f8ee": "🦘 뛰어요!\n🏃 달려요!\n😴 자요!",
  "sb9a71862bf": "😊 기뻐요\n😢 슬퍼요\n⚽ 알리 — 기뻐요!",
  "sbe26e14344": "🤝 내 친구가 되어 줘!\n🧸 같이 놀자!\n🙋‍♂️ 내 차례!\n👉 네 차례야!",
  "sc669f7cbb5": "🌈 무지개를 봤어요.\n🐕 큰 개를 봤어요.\n🍦 아이스크림을 먹었어요.",
  "sc771b061d7": "😊 주므라드 — 그녀는 착해요.\n🥱 키마트 — 그녀는 게을러요.\n🌲 숲\n📦 상자",
  "sd252d4cbec": "✋ 저기요!\n😔 미안해!\n👌 괜찮아.",
  "se650bea51e": "⚽ 공 좀 줄래?\n🫴 여기 있어요.\n👍 네, 주세요.\n🙅 아니요, 괜찮아요.",
  "sea34e821d6": "🍽️ 접시\n🥄 숟가락\n🍴 포크\n🍵 찻잔",
  "sf1941bc326": "👩‍⚕️ 무슨 일이에요?\n🤕 머리가 아파요.\n💊 여기 약이에요.\n💌 빨리 나아!",
  "sf54896dc2d": "🛏️ 침대, 침대, 침대\n😴 자요, 자요, 자요\n🌙 잘 자요!",
  "sf563a08836": "👵 할머니 댁에 갔어요.\n🦒 우리는 동물원에 갔어요.\n😄 재미있었어요!",
  "s1d0ebad5db": "Bola 먹어요 va 마셔요 so'zlarini farqlaydi",
  "s41e73d86d4": "Bola 자요 va 침대 so'zlarini aytadi",
  "s60bed3c7e2": "Bola 기뻐요 va 슬퍼요 ni yuzdan taniydi",
  "sbc8a148fa9": "Bola 박수 쳐요 va 춤춰요 ni bajaradi",
  "sfbaf23e002": "🎵 «어제» qo'shig'i",
  "s002e48766b": "🎵 고양이 어디 있어?",
  "s008ff49c03": "하품하고 기지개를 켜요!",
  "s00af71b1d6": "저기요, 공원이 어디예요?",
  "s00b2117a33": "손을 가슴에 얹어요!",
  "s01137d5e3a": "삐빅! 가족을 봐요! 누가 자고 있어요? 누가 노래하고 있어요? 같이 봐요!",
  "s0164d3f61f": "마당에서 친구들이랑 놀아요.",
  "s01b2d5f641": "할머니랑 저녁을 먹어요.",
  "s03fab93798": "노래해요: 고양이 어디 있어? 고양이 어디 있어? 상자 옆에! 상자 뒤에! 상자 앞에! 고양이가 또 숨었어요. 내가 물어볼게요: 고양이 어디 있어? 여러분이 대답해요!",
  "s041e922673": "알리는 시간을 알고 싶어요. 뭐라고 물어볼까요?",
  "s054a427b49": "일곱 시에 일어나요.",
  "s05c34e5cf0": "🎲 이야기 카드",
  "s0718c26205": "사자가 그물에 걸렸어요.",
  "s0848909e37": "알리는 길을 어떻게 물어볼까요?",
  "s0911318616": "알리는 몇 시에 학교에 가요?",
  "s09643e7b97": "삐빅! 안녕, 친구들! 나는 로봇 카부예요. 지금 뭐 하고 있어요? 같이 말해 봐요!",
  "s0adeb3e6a8": "🎵 «어제» 노래",
  "s0bf1461097": "그릇에 샐러드를 섞어요.",
  "s0d8051d690": "앞으로 걸어요!",
  "s0dbf4b53b1": "화살표가 왼쪽을 가리켜요. 뭐라고 말할까요?",
  "s0e3e13ccb1": "학교에 가려고 옷을 입어요.",
  "s0e47bc3a9c": "어른은 사자, 여러분은 생쥐예요. 사자가 그물에 걸려서 외쳐요: 도와줘! 도와줘! 사자에게 달려가서 그물을 갉고 말해요: 내가 도와줄 수 있어! 사자가 말해요: 고마워, 꼬마 생쥐야! 이제 역할을 바꿔요: 여러분이 사자예요!",
  "s0f68c83d24": "학교에서 점심을 먹어요.",
  "s0fd0bd256e": "쉿! 고양이가 자고 있어요.",
  "s11e1eb66ee": "삐빅! 유치원 점심시간이에요. 예의 바르게 빵을 달라고 해요!",
  "s130b2d0c54": "자르는 흉내를 내요!",
  "s13312e125b": "간호사 선생님은 체온계를 가지고 있어요.",
  "s1362a01f56": "사자가 말해요: 고마워, 꼬마 생쥐야!",
  "s13cbb92d8b": "비가 온 뒤에 무지개를 봤어요.",
  "s15b7be4b30": "삐빅! 똑딱, 똑딱! 나는 카부예요. 내 안에는 시계가 있어요. 시간 말하는 법을 배워요!",
  "s15c7731a39": "삐빅! 똑똑! 손님이 왔어요! 예의 바르게 차를 대접해요.",
  "s15d66ea8c1": "삐빅! 알리가 병원에 있어요. 봐요, 친절한 간호사 선생님이에요! 선생님은 뭘 가지고 있어요?",
  "s1602c4a529": "응! 재미있었어!",
  "s1686249106": "🎭 대화: 간호사 선생님과 함께",
  "s180752c435": "놀이: 건강에 좋으면 박수! 아니면 고개를 저어요! 과일을 먹어요! 짝! 물을 마셔요! 짝! 밤새 텔레비전을 봐요? 안 돼요! 이제 여러분이 말해 봐요: 건강해지려면 뭘 해요?",
  "s18321b13af": "뛰어올라서 하이파이브!",
  "s18bd9181d9": "다 같이 당겨, 당겨, 당겨!",
  "s1a5a31f6c2": "할머니께 차를 따라 드려요. 어디에 따를까요?",
  "s1c7dacbe51": "신호등이 빨간불이에요. 뭐라고 말할까요?",
  "s1cfd93747f": "🎭 여러분은 생쥐예요!",
  "s1d407bdbb7": "점심 먹기 전에 뭘 해요?",
  "s1d7f80c8ef": "할아버지에게 커다란 순무가 있어요.",
  "s1dd35d4e5b": "간호사 선생님은 마지막에 뭐라고 말해요?",
  "s1e71b6cfd0": "라일로는 뭐 하고 있어요?",
  "s1ed8f1de55": "라일로는 마지막에 뭐라고 말했어요?",
  "s1f0069307f": "🎲 신호등 놀이",
  "s1f04ee386c": "친구가 슬퍼 보여요. 뭐라고 물어볼까요?",
  "s1f98e5348a": "알리가 플롭을 먹고 있어요. 뭘 써요?",
  "s211b650c60": "오늘은 우리 졸업식 날이에요!",
  "s2172273242": "맞아요! 알리는 여섯 살이에요.",
  "s2178a0a081": "삐빅! 커다란 사자와 꼬마 생쥐. 꼬마 생쥐가 커다란 사자를 도울 수 있을까요? 같이 들어 봐요!",
  "s21e07e9962": "강아지가 알리에게 달려가고 있어요.",
  "s2246e185b3": "포크로 샐러드를 먹어요.",
  "s236ac393b3": "먹는 흉내를 내요!",
  "s2454754ad0": "알리가 세수하고 있어요. 뭐라고 말해요?",
  "s24e03ddc95": "잘했어요! 사자와 생쥐.",
  "s25cafd1445": "여러분은 무대에 있어요. 먼저 뭐라고 말할까요?",
  "s284edeb4b4": "맞아요! 라일로는 기뻐요.",
  "s28b563d02a": "새 손목시계가 있어요.",
  "s28cc2309ec": "🎲 네일까, 아닐까?",
  "s29dc301cc7": "간호사: 안녕하세요! 무슨 일이에요? 알리: 아파요. 머리가 아파요. 간호사 선생님이 체온계를 써요: 여기 약이에요. 라일로가 말해요: 빨리 나아, 알리! 이제 여러분이 알리예요. 간호사 선생님이 물어요: 무슨 일이에요? 대답해요!",
  "s2b02b6f543": "의자 뒤에 숨어요!",
  "s2b123fe134": "라일로는 할머니께 차를 어떻게 권해요?",
  "s2b3c1d021d": "멈추고 기다려요!",
  "s2c15f86a26": "잘했어요! 좋은 아침이에요, 엄마!",
  "s2c6784694f": "알리는 시간을 알고 싶어요. 엄마에게 뭐라고 물어볼까요?",
  "s2c7a9d0fb2": "일곱 시예요. 일어나요!",
  "s2cacbb5357": "삐빅! 할아버지에게 아주 커다란 순무가 있어요. 당기고 또 당겨요. 누가 도와줄 수 있을까요?",
  "s2d4e54cd03": "도서관에서 책을 읽어요.",
  "s2e407959cb": "축구한 다음에는 물을 마셔요!",
  "s2ebedbdb11": "엄마가 깨워요: 좋은 아침! 뭐라고 대답할까요?",
  "s2f7fcf1d10": "카드 세 장을 그려요: 할머니, 기린, 웃는 얼굴. 카드를 하나 골라서 말해요: 할머니 댁에 갔어요. 우리는 동물원에 갔어요. 재미있었어요! 이제 세 개 다 말하고 주말 이야기를 들려줘요!",
  "s2f9fd8530a": "알리는 학교에 있어요. 새 선생님을 만나요. 여러분이 알리예요. 선생님께 여러분에 대해 말해요!",
  "s304519c004": "엄마랑 플롭을 먹고 있어요.",
  "s313073b1f5": "점심 먹기 전에 손을 씻어요!",
  "s314ca09b31": "삐빅! 오늘은 우리 졸업식이에요! 이제 여러분은 한국어를 할 수 있어요. 정말 자랑스러워요!",
  "s325e7baf0f": "의사 선생님, 배가 아파요.",
  "s33e82bf1ae": "잘했어요! 라일로는 큰 기린을 봤어요.",
  "s3540da8e93": "빨리 나아, 알리!",
  "s3610bf446a": "아이스크림을 핥아요!",
  "s36da5423b9": "토요일에 할머니 댁에 갔어요.",
  "s37e1f36b39": "좋아요! 빨리 나아요!",
  "s3818c7aef4": "동물원에서 사자를 봐요.",
  "s39cfb16539": "강아지처럼 달려요!",
  "s3a5cea37b1": "전화로: 뭐 하고 있어?",
  "s3ba228d0e9": "주므라드는 할아버지를 도와요. 주므라드는 어떤 아이예요?",
  "s3cb87e0e63": "한 줄로 서서 노래하면서 당겨요: 당겨, 당겨, 당겨! 순무가 커요! 개가 와요, 고양이가 와요, 그래도 안 돼요! 생쥐가 와요: 당겨, 당겨, 당겨! 만세! 이제 이야기를 들려줘요. 마지막에 누가 왔어요? 말해요: 생쥐요!",
  "s3cf7e8fc2c": "미끄럼틀 차례 지키기",
  "s3d8c0d0eef": "알리는 주말에 어디에 갔어요?",
  "s3dfce3e5d3": "잘했어! 네 차례야!",
  "s3ecd2d2751": "응! 자동차를 가지고 놀고 있어.",
  "s4133915a81": "네! 머리가 아파요.",
  "s41fb6a6870": "맞아요! 라일로는 책을 읽고 있어요.",
  "s42675fc3be": "알리는 공원을 못 찾아요. 뭐라고 물어볼까요?",
  "s42737c40ce": "삐빅! 알리와 아빠가 타슈켄트에 있는 동물원에 가요. 그런데 길을 몰라요. 여러분이 알리예요. 경찰관 아저씨에게 물어봐요!",
  "s43341c77d0": "빵집에서 따뜻한 빵을 사요.",
  "s450eae4f62": "삐빅! 라일로가 아파요. 엄마랑 병원에 왔어요. 여러분이 라일로예요. 간호사 선생님께 어디가 아픈지 말해요!",
  "s4622e1b842": "기린처럼 쭉 펴요!",
  "s4689f38803": "라일로는 원숭이와 사자를 보고 싶어요. 어디에 갈까요?",
  "s47c50539d7": "키마트는 돕지 않아요. 키마트는 게을러요.",
  "s47e646ea62": "알리는 어떤 동화를 이야기했어요?",
  "s48286f761d": "찾아봐요! 알리는 책을 읽고 싶어요. 어디에 갈까요? 맞아요, 도서관! 라일로는 사자를 보고 싶어요: 동물원! 할머니는 따뜻한 빵을 원해요. 어디에 갈까요? 여러분이 대답해요!",
  "s48346eac1a": "할아버지는 피곤해요. 자고 있어요.",
  "s4879941dc6": "👀 시간을 찾아봐요!",
  "s4895055582": "무대에 올라가서 모두에게 여러분을 소개해요: 안녕하세요! 제 이름은 …예요. 여섯 살이에요. …에 살아요. …을 좋아해요. 마지막에 크게 말해요: 학교 갈 준비 됐어요! 모두 박수 치며 외쳐요: 우리가 해냈어요!",
  "s4a0dfa2e1a": "삐빅! 길에 차가 많아요. 조심하면서 교통 규칙을 배워요!",
  "s4c7affe995": "배를 만져요!",
  "s4e9e42c4df": "삐빅! 남자아이가 길을 잃었어요. 물어봐요: 동물원이 어디예요? 길을 알려 줘요!",
  "s4f73aa6157": "🎲 카부가 틀렸어요!",
  "s4f904704d9": "삐빅! 오늘은 버스를 타고 타슈켄트를 돌아봐요! 창밖을 봐요. 어떤 곳이 보여요?",
  "s50245291ab": "🎭 대화: 매일 뭐 해요?",
  "s5049468450": "사자가 그물에 걸렸어요. 뭐라고 외쳐요?",
  "s50e7bbcc1c": "좋아요! 왼쪽 오른쪽을 봐요!",
  "s50e96fc7cc": "주므라드가 숲에 가요.",
  "s52a1e99110": "시계를 봐요. 몇 시예요?",
  "s52fcd25436": "물고기가 물에서 헤엄치고 있어요.",
  "s530885c6ce": "마지막에 누가 와서 순무 뽑는 걸 도왔어요?",
  "s534ba61303": "가족이랑 아침을 먹어요.",
  "s53b06159e4": "🎵 식탁 노래",
  "s53d5a38070": "아빠랑 축구를 했어요.",
  "s57ee15b1aa": "할머니는 샐러드에 대해 뭐라고 말해요?",
  "s583b256725": "엄마, 몇 시예요?",
  "s58b6022d62": "학교 갈 시간이에요!",
  "s5a6c13bc7e": "노래하면서 놓아요! 접시, 접시, 상 위에! 숟가락, 포크, 상 위에! 차 한 잔, 상 위에! 상이 다 차려졌어요! 이제 내가 포크를 보여 주고 물어볼게요: 이건 뭐예요? 여러분이 대답해요!",
  "s5bf93628e8": "삐빅! 이건 우즈베키스탄 옛날이야기예요. 주므라드는 착해요. 키마트는 게을러요. 같이 들어 봐요!",
  "s5c00322e5b": "빙글빙글 저어요!",
  "s5cb722886c": "노래하며 움직여요: 일어나요, 일어나요! 쭉 펴요! 세수해요! 아침을 먹어요! 맛있어요! 옷을 입어요! 준비 끝! 이제 여러분이 말해 봐요: 아침에 제일 먼저 뭘 해요?",
  "s5ec88bda5b": "새들이 나무에서 노래하고 있어요.",
  "s5f97b88c9a": "🎭 엄마와 알리",
  "s5fc490f647": "할머니는 따뜻한 빵을 원해요. 어디에 갈까요?",
  "s5ff512156b": "라일로, 어제 뭐 했어?",
  "s604cfada92": "삐빅! 똑똑! 할머니가 오셨어요! 여러분이 라일로예요. 인사하고 차와 샐러드를 권해요!",
  "s60f1667e4e": "고양이가 상자 뒤에 있어요.",
  "s61efa4e987": "노래하며 움직여요: 어제, 어제, 뭐 했어? 축구를 했어요! 공원에 갔어요! 이제 내가 물어보면 여러분 이야기를 해요: 어제 뭐 했어?",
  "s6245b0da72": "여섯 살이에요. 학교 갈 준비 됐어요!",
  "s6395660b67": "허공에 써요!",
  "s671ddf19de": "여기 약이에요.",
  "s67cbec76b6": "좋아요! 알리는 옷을 입어요.",
  "s69fad38644": "크게 보여 줘요!",
  "s6a368af5cd": "라일로가 원피스를 입고 있어요. 뭐라고 말해요?",
  "s6b695adb2d": "라일로가 물어요: 어제 뭐 했어? 알리가 대답해요: 큰 개를 봤어! 라일로가 말해요: 나는 무지개를 봤어! 아이스크림을 먹었어! 이제 여러분이 알리예요. 어제 뭘 봤어요? 문장으로 말해요!",
  "s6ce064a547": "경찰관",
  "s6d4fd55a1c": "삐빅! 라일로의 고양이가 또 숨었어요! 상자 옆에 있을까요, 뒤에 있을까요, 앞에 있을까요? 찾아봐요!",
  "s6e36e9155c": "상 위에 접시를 놓아요!",
  "s6e6841f0d0": "아홉 시에 자러 가요.",
  "s6eef25aff2": "월요일 아침 유치원에서",
  "s700fca26ea": "셔츠를 입어요!",
  "s70c2a82ea0": "찾아봐요! 샐러드 만드는 순서를 말해요. 먼저: 샐러드를 만들자! 그다음에 엄마가 토마토를 잘라요. 잘라요! 그다음에 그릇에 넣고... 뭘 할까요? 여러분이 대답해요!",
  "s7113da1832": "친구가 아파요. 뭐라고 말할까요?",
  "s7290acc4a0": "공을 가지고 놀고 있어요.",
  "s7329c0b332": "밤이 늦었고 별이 떴어요. 뭘 해요?",
  "s74c0e151aa": "빨간불이에요. 기다려요!",
  "s752f90260e": "그들은 공원에서 달리고 있어요.",
  "s759691d4ee": "삐빅! 안녕, 친구들! 알리와 라일로는 낮에 어디에 있을까요? 알아봐요!",
  "s7659b92d9f": "알리와 라일로가 마당에서 술래잡기를 하고 있어요. 알리는 뭐라고 말해요?",
  "s77df90ef2e": "알리에게 새 책가방이 있어요. 뭐라고 말해요?",
  "s7901e1c7ec": "토요일에 알리는 할머니 댁에 갔어요. 뭐라고 말해요?",
  "s79084b573a": "월요일 아침이에요. 알리와 라일로가 주말 이야기를 해요. 여러분이 라일로예요!",
  "s790a42e313": "버스 정류장에서 기다려요.",
  "s7ac88ff874": "책가방을 메요!",
  "s7b97bf84a0": "엄마, 오늘 아파요.",
  "s7b9a4c41b0": "손님이 차를 원하지 않아요. 예의 바르게 뭐라고 말해요?",
  "s7cd831b036": "신호등이 빨간불이에요.",
  "s7d234aded1": "라일로 (여러분)",
  "s7f5f3c36d6": "간호사",
  "s80ff56e3eb": "상자에 금이 가득해요!",
  "s810438c35d": "의자 옆에 서요!",
  "s811d1d48d7": "일곱 시 반이에요. 아침 먹을 시간!",
  "s81b080fe7c": "주므라드는 할아버지를 어디에서 만나요?",
  "s81c8f8e9ff": "라일로가 숟가락으로 샐러드를 젓고 있어요. 뭐 하고 있어요?",
  "s82444b1967": "라일로",
  "s843a719f5e": "연못을 봐요. 어느 문장이 맞아요?",
  "s84af180395": "순무가 뽑혔어요! 모두 뭐라고 외쳐요?",
  "s851a43e66c": "알리, 무슨 일이야?",
  "s851e7c0bb0": "도와주세요! 도와줘요!",
  "s860069777f": "어제 알리는 친구들이랑 공을 찼어요. 뭐라고 말해요?",
  "s86e18d3d95": "할머니, 차 드실래요?",
  "s88165a7dec": "뒤쪽을 가리켜요!",
  "s88bca942b4": "어제 라일로는 하늘에서 일곱 가지 색깔을 봤어요. 뭐라고 말해요?",
  "s890c0ceac4": "유치원 점심시간",
  "s89580202a3": "만세! 순무가 뽑혔어요!",
  "s8a107e151b": "라일로가 알리에게 전화해요. 둘은 지금 뭐 하고 있어요? 여러분이 알리예요!",
  "s8a4acb2d04": "손을 흔들며 도와 달라고 외쳐요!",
  "s8aa20dde5b": "사과를 먹는 흉내를 내요!",
  "s8b9f6fc4df": "알리가 책상에서 공책에 그림을 그리고 있어요. 뭐라고 말해요?",
  "s8c3564c636": "미끄럼틀을 타고 내려왔어요. 라일로가 기다리고 있어요. 뭐라고 말할까요?",
  "s8c62e6737f": "인사하며 고맙다고 말해요!",
  "s8cd3b3682c": "길을 건너기 전에 뭘 해요?",
  "s8ea8a30587": "손가락 일곱 개를 보여 줘요!",
  "s9015f395ef": "라일로: 차 드실래요? 손님: 네, 주세요. 알리: 플롭 드실래요? 손님: 네, 주세요! 음, 맛있어요! 이제 여러분이 주인이에요! 나는 손님이에요. 나에게 뭐라고 말할까요? 차를 권해 봐요!",
  "s90355a71e8": "음, 맛있어요, 할머니!",
  "s92b2d107c1": "선생님이 물어요: 차 줄까? 여러분은 차를 마시고 싶어요. 뭐라고 말할까요?",
  "s93f0a0d81e": "알리",
  "s93f28c6c68": "알리는 아침을 먹은 다음에 뭘 해요?",
  "s94e48834f3": "빵집은 공원 옆에 있어요.",
  "s9519466074": "라일로는 어제 일을 물어보고 싶어요. 어느 질문이 맞아요?",
  "s95fb7bd90a": "🎭 알리와 라일로의 대화",
  "s981ea90bd6": "샐러드를 그릇에 담아요.",
  "s99113b02da": "라일로가 물어요: 너는? 알리는 뭐라고 말해요?",
  "s9934e6be06": "아이스크림을 먹었어요. 맛있어요!",
  "s99d81f9ac9": "어른이 흉내를 내요: 자기, 노래하기, 달리기. 여러분은 맞히고 말해요: 그는 자고 있어요. 그녀는 노래하고 있어요. 그들은 달리고 있어요. 그다음에 여러분이 흉내를 내고, 어른이 물어요: 뭐 하고 있어? 여러분이 대답해요: 노래하고 있어요!",
  "s9a07afc3e3": "🎭 대화: 손님이 왔어요",
  "s9a10d097bf": "친구에게 손을 흔들어요!",
  "s9a7119f6f8": "삐빅! 우리는 할머니 정원에 있어요. 동물들을 봐요! 뭐 하고 있어요?",
  "s9b16814c30": "할머니는 차를 마시고 싶어요. 뭐라고 말해요?",
  "s9b8b43bb0c": "책을 펴요!",
  "s9c124003b0": "삐빅! 안녕, 친구들! 해가 졌어요. 저녁에는 뭘 해요?",
  "s9c32f5dacd": "동물원 가는 길",
  "s9c3bd8075b": "생쥐가 그물을 갉아서 사자가 풀려났어요. 사자는 뭐라고 말해요?",
  "s9c456ea18f": "어디에서 길을 건너야 안전해요?",
  "s9d6472674d": "빵집에서 왼쪽으로 돌아요.",
  "s9e124876be": "새처럼 짹짹!",
  "s9ea847fa56": "장난감을 가지고 놀아요!",
  "sa0e9b08c24": "생쥐처럼 찍찍!",
  "sa11b714f88": "쉿! 하고 말해요!",
  "sa28ad642c6": "저녁에 텔레비전을 봐요.",
  "sa2ab4064eb": "내가 이야기하면 여러분이 맞혀요! 누가 할아버지의 나무 나르는 걸 도와줘요? 말해요: 주므라드. 그녀는 착해요. 누가 누워서 돕지 않아요? 키마트. 그녀는 게을러요. 주므라드는 상자 가득 금을 받아요! 여러분은요? 말해요: 나는 착해요!",
  "sa3bd1755df": "알리는 축구를 하고 나서 목이 말라요. 카부는 뭐라고 말해요?",
  "sa48c057aba": "맞아요! 알리는 할머니 댁에 갔어요.",
  "sa613a88291": "삐빅! 아침이에요. 엄마가 알리를 깨우고 있어요. 여러분이 알리예요. 엄마에게 대답해요!",
  "sa909d44da2": "허공에 하트를 그려요!",
  "sa96ab6ca63": "상 위에 접시를 놓아요.",
  "sa9ba33468f": "알리는 몇 살이에요?",
  "sa9c29685cb": "삐빅! 좋은 아침, 친구들! 나는 로봇 카부예요. 아침에 뭘 하는지 말해 봐요!",
  "sab96d3ae76": "의자 앞에 서요!",
  "sabc487486b": "알리 (여러분)",
  "saca0a01b63": "커다란 순무를 보여 줘요!",
  "saca7b9377e": "어제 알리는 아이스크림을 먹었어요. 어느 문장이 맞아요?",
  "sad4f3f8a41": "여기 졸업장이에요. 잘했어요!",
  "sad51721309": "👀 누가 착해요?",
  "sad9541c2b9": "할머니가 오셨어요",
  "sadc2930cdc": "물로 세수해요.",
  "sae5bb08178": "졸업장을 받아요!",
  "saf4e81adc7": "라일로가 노래하고 있어요. 뭐라고 말할까요?",
  "sb1d6423cd9": "주므라드는 도와줘요. 주므라드는 착해요.",
  "sb230177caa": "상자를 열어요!",
  "sb477361f08": "찾아봐요! 알리가 물어요: 몇 시예요? 긴바늘은 12에, 짧은바늘은 7에 있어요. 그러니까: 일곱 시예요! 이제 긴바늘이 6에 있어요. 지금은 몇 시예요? 여러분이 대답해요!",
  "sb4faa0e857": "두 손으로 찻잔을 드려요!",
  "sb73f12d3fb": "눈을 감아요. 들어 봐요! 짹짹! 누구예요? 말해요: 새들이 노래하고 있어요. 첨벙! 물고기가 헤엄치고 있어요. 이제 눈을 떠요. 내가 물어볼게요: 고양이는 뭐 하고 있어요? 문장으로 대답해요!",
  "sb7498846ef": "선생님이 물어요: 학교 갈 준비 됐니? 알리는 뭐라고 말해요?",
  "sb8780886a1": "삐빅! 곧 손님이 와요! 상 위에 뭘 놓을까요? 낱말을 배워요!",
  "sb8ff4f870c": "세수해요!",
  "sb91138a9d8": "기지개를 켜고 일어나요!",
  "sbba5a6b975": "라일로는 동물원에서 뭘 봤어요?",
  "sbbbf415d62": "🎵 아야 노래",
  "sbce28977ab": "좋아요! 맛있어요!",
  "sbd0a297fcd": "새 선생님을 만나요",
  "sbd12165657": "남자아이: 저기요, 동물원이 어디예요? 라일로: 앞으로 쭉 가요. 빵집에서 왼쪽으로 돌아요. 동물원은 공원 옆에 있어요. 남자아이: 고마워! 이제 여러분이 길을 알려 줘요! 남자아이가 물어요: 도서관이 어디예요? 뭐라고 말할까요?",
  "sbdd1ffe4e4": "나는 도서관 앞에 서 있어요.",
  "sbe5396ee02": "잘했어요! 무슨 일이에요?",
  "sbff74b68df": "잘했어요! 차 드실래요?",
  "sc17caba6eb": "🎵 아침 노래",
  "sc2ecf2b3ca": "맞아요! 공원 옆에 있어요.",
  "sc375700e5b": "삐빅! 안녕, 친구들! 어제 나는 공원에 갔어요. 여러분은 어제 뭐 했어요?",
  "sc49192b6b0": "우리는 기린을 봤어요. 재미있었어요!",
  "sc55fc597ad": "알리와 라일로가 공원에 있어요. 빨리 달려요. 어느 문장이 맞아요?",
  "sc62a91fd7f": "간호사 선생님은 라일로에게 뭐라고 물어요?",
  "sc7a9bd9eb5": "선생님이 빵을 줘요: 여기 있어. 뭐라고 말할까요?",
  "sc7df0eb3d4": "할머니 플롭이 정말 맛있어요! 뭐라고 말할까요?",
  "sc7e6f4efe0": "간호사 선생님은 아주 친절해요.",
  "sc847213da9": "알리, 뭐 하고 있어?",
  "sc89da6df77": "잘했어요! 고양이가 자고 있어요.",
  "sc8d2228083": "엄마랑 샐러드를 만들어요!",
  "sc8e9f83516": "삐빅! 좋은 아침! 일어나서 유치원 갈 준비를 해요!",
  "sca7dc34eca": "키 큰 나무가 되어 봐요!",
  "scb0c0306ac": "고양이가 상자 뒤쪽에 있어요. 어디에 있어요?",
  "scb8eb37096": "응! 가자!",
  "sccb6e9d293": "👀 찾아봐요: 어디에 갈까요?",
  "scd2c553170": "놀이! 내가 색깔을 말해요. 빨간색: 기다려요! 하고 가만히 서요. 초록색: 왼쪽 오른쪽을 봐요! 하고 제자리에서 걸어요! 빨간색! 초록색! 이제 여러분이 말해 봐요: 빨간불이에요. 뭐라고 말할까요?",
  "scd563ef9a8": "공원에서 오른쪽으로 돌아요.",
  "scdf110d2b2": "👀 정원에 누가 있어요?",
  "sce65ed9a5e": "라일로가 웃으면서 뛰고 있어요. 기분이 어때요?",
  "sceb135f585": "병원에서 아픈 사람을 누가 도와줘요?",
  "sd063593371": "샐러드를 어디에 담을까요?",
  "sd070d76ebd": "삐빅! 월요일이에요. 알리가 주말 이야기를 해요. 같이 들어 봐요!",
  "sd1052ee9f1": "책을 읽고 있어요.",
  "sd12aae8913": "삐빅! 나는 배터리로 힘을 얻어요. 여러분은 어떻게 건강하고 튼튼해져요? 내 비밀 네 가지를 배워요!",
  "sd177f67e4d": "라일로는 알리가 지금 뭐 하는지 알고 싶어요. 뭐라고 물어봐요?",
  "sd1d20c9161": "잘했어요! 저기요! 동물원이 어디예요?",
  "sd2b9377e0d": "🎭 대화: 길 묻기",
  "sd3d20bd772": "라일로가 배를 잡고 있어요. 뭐라고 말해요?",
  "sd3ff0ed5fc": "손목을 봐요!",
  "sd4e50aad9a": "사자처럼 어흥!",
  "sd5055d5cd1": "맞아요! 네, 주세요.",
  "sd653b2bcb6": "알리가 책을 들고 있어요. 엄마가 물어요: 뭐 하고 있어? 알리는 뭐라고 말해요?",
  "sd6f5a2d632": "뛰면서 만세! 하고 외쳐요!",
  "sdba5b16caf": "일요일에 우리는 동물원에 갔어요.",
  "sdc46079f56": "👀 찾아봐요: 다음은 뭐예요?",
  "sdc7c93315d": "맞아요! 일곱 시 반이에요.",
  "sdeadebdc4e": "할머니께 차 한 잔!",
  "se084209421": "가방이 준비됐어요. 문 앞에 있어요. 뭐라고 말할까요?",
  "se25e88ab6e": "네, 주세요. 차를 좋아해요.",
  "se2aaa42bbf": "삐빅! 어제 하늘에서 무지개를 봤어요! 여러분은 뭘 봤어요?",
  "se2d4ac1a23": "노래하며 보여 줘요! 무슨 일이야? 무슨 일이야? 머리를 만져요: 머리가 아파요! 배를 만져요: 배가 아파요! 이제 내가 물어볼게요: 무슨 일이야? 여러분이 대답해요!",
  "se40e41e85f": "알리가 버스를 기다리고 있어요. 알리는 어디에 있어요?",
  "se4b9b5ecd5": "숟가락으로 먹어요!",
  "se5d846e1ab": "엄마, 머리가 아파요.",
  "se6358acf7c": "사자는 크고 힘이 세요.",
  "se6bcbace8a": "아침 준비하기",
  "se796bd92db": "삐빅! 안녕, 친구들. 알리가 오늘 침대에 누워 있어요. 물어봐요: 무슨 일이야?",
  "se7a85db57d": "어른은 엄마, 여러분은 알리예요. 엄마가 물어요: 뭐 하고 있어? 흉내 내며 대답해요: 놀고 있어요. 책을 읽고 있어요. 먹고 있어요. 이제 역할을 바꿔요. 여러분이 물어봐요: 뭐 하고 있어?",
  "se87e5e8dc7": "알리가 물어요: 매일 뭐 해? 라일로가 말해요: 학교에 가요. 점심을 먹어요. 친구들이랑 놀아요! 이제 알리가 여러분에게 물어요. 뭐라고 말할까요? 말해요: 학교에 가요!",
  "se93970ede6": "매일 과일을 먹어요!",
  "se93d8666c1": "왼쪽 오른쪽을 보고 건너요.",
  "se9eb1df1a4": "삐빅! 봐요, 미끄럼틀이에요! 친구를 사귀고 차례대로 타요.",
  "sea0d3e0785": "아니요, 괜찮아요. 배불러요.",
  "sead3fb18cf": "잘했어요! 몇 시예요?",
  "sec9a250937": "🎲 누가 뭐 하고 있어요?",
  "secedd6f588": "엄마, 토마토 좀 잘라 주세요.",
  "sed2211dfb4": "삐빅! 오늘은 부엌에서 엄마를 도와요. 토마토랑 오이가 있어요. 샐러드를 만들자!",
  "sed9f225286": "점심시간이에요. 알리는 뭐라고 말해요?",
  "sef371218ed": "꼬마 생쥐가 도와줄 수 있어요.",
  "sef4c28be4e": "알리, 라일로, 우리가 해냈어!",
  "sef6a3adab1": "모자를 써요!",
  "sef8f1fedee": "숟가락으로 수프를 먹어요.",
  "sf0a32178dc": "어제 공원에 갔어요.",
  "sf0e2b42b79": "횡단보도는 학교 옆에 있어요.",
  "sf20d9a5ee0": "동물원이 정말 좋았어요! 뭐라고 말할까요?",
  "sf256afcd9a": "봐요! 그녀는 노래를 부르고 있어요.",
  "sf2aa08e330": "책상에서 숙제를 해요.",
  "sf2b16e4aa4": "놀이: 카부가 헷갈렸어요! 내가 말해요: 자러 가요. 저녁을 먹어요. 아니, 아니! 저녁 먼저, 그다음에 잠! 바르게 말해 봐요: 저녁을 먹어요. 그다음엔? 이제 여러분이 말해 봐요: 저녁에 마지막으로 뭘 해요?",
  "sf31e684b60": "도서관까지 앞으로 쭉 가요.",
  "sf3c154517b": "꼼짝 못 하는 흉내를 내요!",
  "sf4d6a1f329": "🎤 졸업식 무대",
  "sf55615f3cb": "병원에서",
  "sf5ba88e767": "잘 자! 푹 자, 알리!",
  "sf8744695c4": "🎵 순무 노래",
  "sf8c2ab3ce3": "손을 비벼요!",
  "sf8df156db3": "라일로가 머리가 아파요. 뭐라고 말해요?",
  "sfa5f9be691": "큰 개를 봤어요. 멍멍!",
  "sfbd6cd2784": "공을 차요!",
  "sfd659a513a": "마시는 흉내를 내요!",
  "sfd7f969875": "어깨를 으쓱하며 물어봐요!",
  "sfea1d643f9": "이마를 만져요!",
  "sff4a273d4d": "알리의 고양이는 뭐 하고 있어요?",
  "s0075e4cb90": "👀 Kim mehribon?",
  "s04434b2506": "Xursand va xafa",
  "s0601aaca36": "Bola shahar joylarini aytadi",
  "s06615f4424": "Qarsak va raqs",
  "s06cd0ed305": "Kechqurun",
  "s088727dad1": "Bola ertalabki ishlarni aytadi",
  "s08d70b1e2d": "Yuvinamiz",
  "s0d104232bd": "🎲 Hikoya kartalari",
  "s0df6f831bd": "Kun tartibi",
  "s0eeb955934": "🎭 Ali va Laylo suhbati",
  "s104102fb07": "🎭 Yuzlar o'yini",
  "s10562fa0e2": "Do'stim bo'l!",
  "s10c3d785c3": "Bola hamshiraga nima og'riyotganini aytadi va maslahatni tushunadi",
  "s11a87c5834": "Mening kunim",
  "s11c267e214": "Harakat qilamiz",
  "s149b7ca33e": "Nima bo'ldi?",
  "s1609a47a61": "Yangi ustoz bilan tanishuv",
  "s16c5dfdbab": "Kechirasiz",
  "s17c5782f4c": "Salat tayyorlaymiz",
  "s1aa2202c65": "Bola sog'lom odatlarni aytadi",
  "s1f36498161": "Bola soatni aytadi",
  "s22efbe23ac": "Bola ertalab oyisi bilan salomlashadi, sumkasini oladi va yo'lga chiqadi",
  "s265b977e77": "Ertalab",
  "s28ff94d2fa": "Ko'rdim",
  "s29351e8345": "🎲 Yeymizmi, ichamizmi?",
  "s299f245c67": "Bola maydonchada do'st orttiradi, birga o'ynashni taklif qiladi va navbat beradi",
  "s2f730ceb16": "Hozir nima qilyapsan?",
  "s3380e1f72c": "Mehmon kutamiz",
  "s351b084819": "Bola kechki ishlar va uyqu iboralarini aytadi",
  "s37810c5dad": "Bola shifoxona so'zlarini aytadi",
  "s382ac0da75": "Bola mehnatsevarlik haqidagi ertakni tinglaydi",
  "s398aeee8a8": "Bog'chaga boraman",
  "s39d44c6ed3": "Bola oshxona fe'llarini aytadi",
  "s400c794396": "Zumrad va Qimmat",
  "s41beceb151": "Yo'l qoidalari",
