              "sarlavha": "Bosh ildiz va ikki yechim",
              "shart": "√(−36) ni yozing va z²=−36 ni yeching.",
              "qadamlar": [
                "(6i)²=36i²=−36.",
                "(−6i)² ham −36 ga teng.",
                "Bosh ildiz belgisi bu juftlikdan 6i ni bildiradi."
