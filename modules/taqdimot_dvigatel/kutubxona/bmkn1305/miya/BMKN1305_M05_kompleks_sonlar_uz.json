        {
          "sarlavha": "Bo‘luvchini haqiqiy songa aylantirish",
          "izoh": "Bo‘linmaning surat va maxrajini bo‘luvchining qo‘shmasiga ko‘paytiramiz. Maxraj c²+d² ga teng bo‘ladi. Bu son bo‘luvchi nol bo‘lmaganida musbat bo‘lishi sababli bo‘lish aniqlanadi.",
          "elementlar": [
            {
              "tur": "formula",
              "sarlavha": "Bo‘lish formulasi",
              "formula": "\\frac{a+bi}{c+di}=\\frac{(a+bi)(c-di)}{c^2+d^2},\\quad c+di\\ne0",
