      "slaydlar": [
        {
          "sarlavha": "Haqiqiy sonlardan keyingi kengayish",
          "izoh": "Haqiqiy sonlar ichida kvadrati −1 bo‘lgan son yo‘q. Kompleks sonlar sistemasida i belgisi i²=−1 shartini qanoatlantiradi. i ni noma’lum haqiqiy son deb emas, kengaytirilgan sonlar sistemasining elementi deb talqin qiling.",
          "elementlar": [
            {
              "tur": "tarif",
              "matn": "Mavhum birlik i uchun i² = −1. Kompleks son a+bi shaklida yoziladi, bunda a va b haqiqiy sonlar.",
