DATABASE_URL=postgresql://.../...
JWT_MAXFIY_KALIT=replace-with-64-random-characters
FRONTEND_URL=https://frontend.example.com
FRONTEND_URLS=https://frontend.example.com
REDIS_URL=redis://...
WEB_CONCURRENCY=4
DB_POOL_MAX=8
DB_POOL_WAIT_SECONDS=2
MAX_INFLIGHT_REQUESTS=250
MAX_HEAVY_REQUESTS=2
MICROCACHE_TTL_SECONDS=3
# Production PostgreSQL should be behind PgBouncer transaction pooling.
MICROCACHE_MAX_ENTRIES=256
